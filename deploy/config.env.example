# ============================================================
# QwenPaw + FRP + Chromium 一键部署配置模板
# 复制为 config.env 并填写 (cp config.env.example config.env)
# 所有字段都填好后再运行: bash deploy.sh
# ============================================================

# ---------- 1. FRP 隧道配置 (必填) ----------

# 中继服务器公网 IP (frp 服务端所在机器)
FRP_SERVER_IP=YOUR_FRP_SERVER_IP

# 中继服务器 FRP 通信端口 (服务端 bindPort, 默认 7000)
FRP_SERVER_PORT=7000

# 认证 TOKEN (与服务端 auth.token 一致)
FRP_TOKEN=YOUR_FRP_TOKEN

# SSH 远程映射端口 (通过 frp 暴露 ssh, 公网 ssh -p 该端口)
FRP_SSH_REMOTE_PORT=YOUR_SSH_REMOTE_PORT

# noVNC 远程映射端口 (公网访问 vnc.html 的端口)
FRP_VNC_REMOTE_PORT=YOUR_VNC_REMOTE_PORT

# qwenpaw web 远程映射端口 (公网访问 qwenpaw 面板的端口, 可留空跳过)
FRP_APP_REMOTE_PORT=YOUR_APP_REMOTE_PORT

# ---------- 2. 本机服务端口 (一般不用改) ----------

# 本地 SSH 端口
LOCAL_SSH_PORT=22

# noVNC 监听端口 (vnc-browser.sh 默认)
VNC_PORT=8080

# qwenpaw app 监听端口
QWENPAW_PORT=8088

# ---------- 3. VNC 浏览器配置 ----------

# VNC 密码 (访问 noVNC 用的密码)
VNC_PASSWORD=YOUR_VNC_PASSWORD

# 桌面分辨率 (手机竖屏: 720x1280, 电脑横屏: 1280x720)
RESOLUTION=720x1280

# ---------- 4. QwenPaw 配置 ----------

# qwenpaw 数据目录 (持久化, 默认 ~/.qwenpaw)
QWENPAW_HOME=${HOME}/.qwenpaw

# ---------- 5. 浏览器数据持久化目录 (可选) ----------

# chromium 用户数据目录 (书签/登录态, 建议放持久化盘)
CHROMIUM_PROFILE_DIR=/data/chromium-profile

# ============================================================
# 填好后运行:
#   bash deploy.sh
# 部署完成后:
#   VNC浏览器: http://${FRP_SERVER_IP}:${FRP_VNC_REMOTE_PORT}/vnc.html
#   SSH:       ssh -p ${FRP_SSH_REMOTE_PORT} root@${FRP_SERVER_IP}
# ============================================================
