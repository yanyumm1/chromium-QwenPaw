# ============================================================
# QwenPaw + FRP + Chromium 一键还原配置模板
#
# 使用流程:
#   1. 在【你的 VPS 公网服务器】上运行:
#        bash <(curl -Ls https://main.ssss.nyc.mn/frp.sh)
#      选 1 安装 FRP 服务端, 会得到:
#        - 监听IP (服务器公网IP)
#        - 监听端口 (默认 7000)
#        - 认证TOKEN (随机生成的一串)
#      记下这几个值
#   2. 在【任意 qwenpaw 机器】上:
#        cp config.env.example config.env
#        把 VPS 上拿到的值填进下面
#   3. 运行:
#        bash restore.sh
#      一键还原: frp 隧道 + Chromium 桌面 + qwenpaw 服务
# ============================================================

# ---------- 1. FRP 服务端信息 (VPS 上 frp.sh 装服务端拿到的值) ----------

# 中继服务器公网 IP (frp.sh 输出的 "监听IP")
FRP_SERVER_IP=YOUR_SERVER_IP

# FRP 服务端监听端口 (frp.sh 默认 7000)
FRP_SERVER_PORT=7000

# 认证 TOKEN (frp.sh 输出的 "认证TOKEN")
FRP_TOKEN=YOUR_FRP_TOKEN

# ---------- 2. 公网映射端口 (选好不冲突的端口) ----------

# SSH 远程映射端口 (frp.sh 客户端默认 6000)
FRP_SSH_REMOTE_PORT=YOUR_SSH_REMOTE_PORT

# noVNC 远程端口 (公网访问 vnc.html, 自己定一个不冲突的端口)
FRP_VNC_REMOTE_PORT=YOUR_VNC_REMOTE_PORT

# qwenpaw 面板远程端口 (可选, 留空跳过)
FRP_APP_REMOTE_PORT=YOUR_APP_REMOTE_PORT

# ---------- 3. 本机服务端口 (一般不用改) ----------

# 本地 SSH 端口
LOCAL_SSH_PORT=22

# noVNC 监听端口
VNC_PORT=8080

# qwenpaw app 监听端口
QWENPAW_PORT=8088

# ---------- 4. VNC 浏览器配置 ----------

# VNC 密码 (访问 noVNC 用)
VNC_PASSWORD=YOUR_VNC_PASSWORD

# 桌面分辨率 (手机竖屏: 720x1280, 电脑横屏: 1280x720)
RESOLUTION=720x1280

# ---------- 5. 数据持久化 (NAS) ----------

# NAS 持久化根目录 (容器重启不丢的盘)
NAS_BASE_DIR=/run/csi/mount-root/nas/4079184d856ecc166ed19d4887083405/workspaces/default

# qwenpaw 数据目录 (部署时自动检测, 通常 /app/working)
QWENPAW_DATA_DIR=/app/working

# chromium 浏览器数据目录 (放 NAS, 重启不丢书签/登录态)
CHROMIUM_PROFILE_DIR=${NAS_BASE_DIR}/browser/chromium-gui-profile

# 定时备份间隔 (秒, 默认 1800 = 30分钟)
BACKUP_INTERVAL=1800

# ============================================================
# 填好后运行: bash restore.sh
# ============================================================
