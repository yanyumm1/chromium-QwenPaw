# ============================================================
# chromium-QwenPaw 环境变量配置模板
# 复制为 .env 并填写 (cp .env.example .env)
# 部署时 entrypoint 会自动加载
# ============================================================

# ---- 必填: Cloudflare 隧道 (选一种) ----
# 方式A: Token 模式 (推荐, 类似 komari-argo-hug)
# 从 CF Zero Trust -> Networks -> Tunnels 复制 token (eyJ...)
ARGO_AUTH=eyJxxxxx
# 隧道绑定的域名 (用于日志显示, 可选)
ARGO_DOMAIN=your-domain.com

# ---- noVNC 浏览器 ----
# noVNC 网页监听端口 (默认 8080, 可自定义)
PORT=8080
# VNC 登录密码 (强烈建议修改)
VNC_PASSWORD=password
# 桌面分辨率
RESOLUTION=1280x720

# ---- GitHub 备份 Chromium 配置 (可选, 全填才启用) ----
GBACKUP_USER=
GBACKUP_REPO=
GBACKUP_TOKEN=
AUTO_BACKUP=NO
AUTO_RESTORE=NO
INTERVALINSECONDS=1800

# ---- 哪吒监控 (可选, 不填不启用) ----
NEZHA_SERVER=
NEZHA_KEY=
NEZHA_PORT=443
NEZHA_VERSION=V1